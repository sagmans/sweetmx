# A resize at the smallest size. Passes when a window that a removal left
# too small comes back to the limit, a request to shrink it more leaves it
# as it is, and a request to grow it still works.
create
create
create
focus left
resize right 5
focus left
resize right -5
focus right
focus right
# Window 3 leaves. The two that stay share its width, and window 1 gets
# exactly a fifth of an equal share: a tenth of the screen, 192 points.
send 1 0
focus left
resize right -0.01
resize right 0.01
