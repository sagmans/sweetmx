# A resize near the smallest size. Passes when a request to shrink a window
# that is already below the limit leaves it as it is, and a request to grow
# it still works: the limit stops a border, it never moves one back.
create
create
create
focus left
resize right 5
focus left
resize right -5
focus right
focus right
# Window 3 leaves. The two that stay share its width, and window 1 is now a
# little below a fifth of an equal share.
send 1 0
focus left
resize right -0.01
resize right 0.01
