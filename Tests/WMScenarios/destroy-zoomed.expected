> focus left
grid 0,0 workspaces 1 zoom 0
tree @h(1 2* 3)
frame 1 0 0 640 1080
frame 2 640 0 640 1080
frame 3 1280 0 640 1080
hidden -
effects 1
  focus 2

> zoom in
grid 0,0 workspaces 1 zoom 1
tree h(1 @2* 3)
frame 2 0 0 1920 1080
hidden 1 3
effects 3
  hide 1
  hide 3
  frame 2 0 0 1920 1080

> destroy 2
grid 0,0 workspaces 1 zoom 0
tree @h(1* 3)
frame 1 0 0 960 1080
frame 3 960 0 960 1080
hidden -
effects 3
  frame 1 0 0 960 1080
  frame 3 960 0 960 1080
  focus 1
