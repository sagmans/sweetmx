> create
grid 0,0 workspaces 1 zoom 0
tree @1*
frame 1 0 0 1920 1080
hidden -
effects 2
  frame 1 0 0 1920 1080
  focus 1

> create
grid 0,0 workspaces 1 zoom 0
tree @h(1 2*)
frame 1 0 0 960 1080
frame 2 960 0 960 1080
hidden -
effects 3
  frame 1 0 0 960 1080
  frame 2 960 0 960 1080
  focus 2

> create
grid 0,0 workspaces 1 zoom 0
tree @h(1 2 3*)
frame 1 0 0 640 1080
frame 2 640 0 640 1080
frame 3 1280 0 640 1080
hidden -
effects 4
  frame 1 0 0 640 1080
  frame 2 640 0 640 1080
  frame 3 1280 0 640 1080
  focus 3

> focus left
grid 0,0 workspaces 1 zoom 0
tree @h(1 2* 3)
frame 1 0 0 640 1080
frame 2 640 0 640 1080
frame 3 1280 0 640 1080
hidden -
effects 1
  focus 2

> zoom in
grid 0,0 workspaces 1 zoom 1
tree h(1 @2* 3)
frame 2 0 0 1920 1080
hidden 1 3
effects 3
  hide 1
  hide 3
  frame 2 0 0 1920 1080

> create
grid 0,0 workspaces 1 zoom 1
tree h(1 @v(2 4*) 3)
frame 2 0 0 1920 540
frame 4 0 540 1920 540
hidden 1 3
effects 3
  frame 2 0 0 1920 540
  frame 4 0 540 1920 540
  focus 4

> create
grid 0,0 workspaces 1 zoom 1
tree h(1 @v(2 4 5*) 3)
frame 2 0 0 1920 360
frame 4 0 360 1920 360
frame 5 0 720 1920 360
hidden 1 3
effects 4
  frame 2 0 0 1920 360
  frame 4 0 360 1920 360
  frame 5 0 720 1920 360
  focus 5

> zoom out
grid 0,0 workspaces 1 zoom 0
tree @h(1 v(2 4 5*) 3)
frame 1 0 0 640 1080
frame 2 640 0 640 360
frame 4 640 360 640 360
frame 5 640 720 640 360
frame 3 1280 0 640 1080
hidden -
effects 5
  frame 1 0 0 640 1080
  frame 2 640 0 640 360
  frame 4 640 360 640 360
  frame 5 640 720 640 360
  frame 3 1280 0 640 1080
