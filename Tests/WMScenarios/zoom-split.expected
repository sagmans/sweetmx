> create
grid 0,0 workspaces 1 zoom 0
tree @1*
frame 1 0 0 1920 1080
hidden -
effects 2
  frame 1 0 0 1920 1080
  focus 1

> create
grid 0,0 workspaces 1 zoom 0
tree @h(1 2*)
frame 1 0 0 960 1080
frame 2 960 0 960 1080
hidden -
effects 3
  frame 1 0 0 960 1080
  frame 2 960 0 960 1080
  focus 2

> split vertical
grid 0,0 workspaces 1 zoom 0
tree @h(1 v(2*))
frame 1 0 0 960 1080
frame 2 960 0 960 1080
hidden -
effects 0

> zoom in
grid 0,0 workspaces 1 zoom 1
tree h(1 @v(2*))
frame 2 0 0 1920 1080
hidden 1
effects 2
  hide 1
  frame 2 0 0 1920 1080

> zoom in
grid 0,0 workspaces 1 zoom 2
tree h(1 v(@2*))
frame 2 0 0 1920 1080
hidden 1
effects 0

> split horizontal
grid 0,0 workspaces 1 zoom 2
tree h(1 v(@h(2*)))
frame 2 0 0 1920 1080
hidden 1
effects 0

